# ============================================================
# 悦心养生馆 - 环境变量示例
# 拷贝为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- 管理后台账号 ----
ADMIN_USERNAME=admin
# 二选一：明文（≥8 位强密码） 或 bcrypt 哈希（推荐）
# 生成 bcrypt 哈希：
#   python -c "import bcrypt;print(bcrypt.hashpw(b'你的密码', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD=ChangeMe@2026!
# ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 是否启用后台鉴权（生产请保持 true）
ADMIN_AUTH_ENABLED=true

# ---- Token 签名密钥（≥ 32 位）----
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=请替换为至少32位随机字符串_例如_token_urlsafe_48_的输出

# ---- 安全策略 ----
# CORS 允许的源（逗号分隔，生产请明确域名）
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# 是否允许 Token 通过 query 参数传递（生产必须 false）
ALLOW_TOKEN_QUERY=false

# 是否启用应用层限流（多 worker 部署可关闭，由 Nginx 限流取代）
RATE_LIMIT_ENABLED=true

# 登录失败锁定阈值
LOGIN_FAIL_THRESHOLD=10
LOGIN_FAIL_LOCK_MINUTES=15

# ---- 数据库 ----
# 默认 SQLite（开箱即用）。生产推荐 MySQL：
DB_BACKEND=sqlite
# DB_BACKEND=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=yuexin
# DB_PASSWORD=请改成强密码
# DB_NAME=yuexin

# ---- 仅本地开发：跳过启动期安全断言（生产严禁启用）----
# YUEXIN_ALLOW_DEFAULT_SECRETS=1
