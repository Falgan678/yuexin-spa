<?xml version="1.0" encoding="UTF-8"?>
<!--
  悦心养生馆 sitemap
  - 部署时请把 https://www.example.com 替换为真实域名
  - <lastmod> 建议由后端在响应 /sitemap.xml 时动态生成（见 main.py 里的 /sitemap.xml 路由）
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://www.example.com/</loc>
        <lastmod>2026-05-28</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>https://www.example.com/#services</loc>
        <lastmod>2026-05-28</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    <url>
        <loc>https://www.example.com/#environment</loc>
        <lastmod>2026-05-28</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>https://www.example.com/#offers</loc>
        <lastmod>2026-05-28</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>https://www.example.com/#contact</loc>
        <lastmod>2026-05-28</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
</urlset>
