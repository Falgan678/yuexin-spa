# ============================================================
# 悦心养生馆 - 生产环境变量模板（拷贝为 .env 后填入真实值）
#
# ⚠️  禁止直接将本文件改名为 .env 上传到生产。请：
#   1) cp .env.production.example .env
#   2) 用本文件下方注释里的命令生成真实的随机值
#   3) 妥善保管，绝不入仓库（已在 .gitignore 中忽略）
# ============================================================

# ============== 必填：1) 后台管理员账号 ==============
ADMIN_USERNAME=admin

# 推荐使用 bcrypt 哈希（明文不进环境变量）：
#   python -c "import bcrypt;print(bcrypt.hashpw(b'你的强密码', bcrypt.gensalt()).decode())"
# 生成结果形如  $2b$12$.... 直接粘贴到下面：
ADMIN_PASSWORD_HASH=

# 也可改用明文（≥ 8 位 且非默认弱密码）。若同时配置则 HASH 优先：
# ADMIN_PASSWORD=

# 启用管理后台登录（生产固定 true）
ADMIN_AUTH_ENABLED=true


# ============== 必填：2) Token 签名密钥（≥ 32 位）==============
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=


# ============== 必填：3) 允许的来源（CORS 白名单）==============
# 生产必须填写真实域名（多个用英文逗号分隔），且不得包含 localhost / 127.0.0.1
ALLOWED_ORIGINS=https://your-domain.com


# ============== 必填：4) 数据库（生产强烈建议 MySQL）==============
DB_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yuexin
DB_PASSWORD=
DB_NAME=yuexin

# 如确需用 SQLite（不推荐用于多 worker 写入场景）：
# DB_BACKEND=sqlite
# SQLITE_PATH=/app/data/yuexin.db


# ============== 必填：5) 反向代理 ==============
# 仅当部署在 Nginx / 网关后才设为 true（用于读取 X-Forwarded-For）
# 否则攻击者可伪造客户端 IP 绕过限流 / 登录锁定
TRUST_PROXY_HEADERS=true


# ============== 安全策略（默认值已是生产推荐值）==============
# Token 仅允许通过 Authorization Header 传递（防 referer 泄露）
ALLOW_TOKEN_QUERY=false

# 关闭 Swagger / OpenAPI 文档（避免暴露内部接口）
DOCS_ENABLED=false

# 应用层限流（如 Nginx 已限流可设 false）
RATE_LIMIT_ENABLED=true

# 登录失败锁定（同 IP）
LOGIN_FAIL_THRESHOLD=10
LOGIN_FAIL_LOCK_MINUTES=15


# ============== 数据保留策略 ==============
# 应用启动 + 每日定时任务自动清理过期数据，防止表无限膨胀
ANALYTICS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180


# ============== 严禁打开的开关（生产）==============
# YUEXIN_ALLOW_DEFAULT_SECRETS=1   # 仅本机开发用，生产开启等于裸奔
