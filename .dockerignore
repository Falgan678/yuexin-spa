# ============================================================
# Docker 构建忽略清单（与 .gitignore 解耦，单独维护）
# 目的：避免把开发凭据 / 真实数据 / 缓存 / 测试 打进镜像
# ============================================================

# 版本控制 / IDE
.git/
.github/
.gitignore
.gitattributes
.vscode/
.idea/

# 环境变量（务必通过编排平台注入，不打进镜像）
.env
.env.*
!.env.example

# Python 构建副产物
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# 项目数据文件（生产请挂卷或单独迁移）
*.db
*.db-journal
*.sqlite
*.sqlite3

# 日志
*.log
uvicorn*.err
uvicorn*.out

# 测试 / 开发文档
tests/
output/
README_LOCAL.md
.playwright-cli/

# 前端构建产物（如果未来用）
node_modules/
dist/
build/

# 操作系统
.DS_Store
Thumbs.db
